{
  "name": "token-larper",
  "version": "1.10.3",
  "description": "Token Larper — Multi-Harness AI Coding Usage & Cost Telemetry Dashboard powered by ccusage",
  "type": "module",
  "license": "MIT",
  "author": "YarooqH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YarooqH/token-larper.git"
  },
  "homepage": "https://github.com/YarooqH/token-larper#readme",
  "bugs": {
    "url": "https://github.com/YarooqH/token-larper/issues"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "!src/**/*.test.ts",
    "Start-TokenLarper.vbs",
    "README.md",
    "llms.txt"
  ],
  "bin": {
    "token-larper": "bin/cli.js",
    "tokenlarper": "bin/cli.js"
  },
  "keywords": [
    "claude-code",
    "ccusage",
    "antigravity",
    "codex",
    "copilot-cli",
    "opencode",
    "token-tracker",
    "token-usage",
    "ai-coding-agents",
    "llm-observability",
    "cost-telemetry",
    "system-tray",
    "bun"
  ],
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "start": "bun src/server.ts",
    "tray": "wscript.exe //B //Nologo Start-TokenLarper.vbs",
    "stop": "bun -e \"fetch('http://127.0.0.1:4269/api/shutdown',{method:'POST',headers:{'Content-Type':'application/json'}}).then(()=>console.log('Stopped Token Larper')).catch(()=>console.log('Not running'))\""
  },
  "dependencies": {
    "ccusage": "20.0.24",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
